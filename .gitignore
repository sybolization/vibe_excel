# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo

# Python 虚拟环境（由 uv 生成，不提交）
.venv/
__pycache__/
*.py[cod]

# 凭证
.env
.env.*
!.env.example

# 数据与制品不进代码仓库（指南 §6.1）
# 原始 Excel、SQLite 数据库、输出文件、个人信息标注、trace 一律放在
# 仓库外的制品存储（默认 <repo>/../vibe_excel-store，见 ADR-0001）。
.store/
inputs/
sessions/
artifacts/
traces/
data-revisions/
spikes/*/out/
*.db
*.db-journal
*.db-wal
*.db-shm

# 合成数据一律由代码生成，不提交二进制表格。
# 若将来确有需要提交夹具，在此目录下加 ! 例外。
*.xlsx
*.xls
